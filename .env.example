# Template for the local .env file (which is git-ignored).
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# OLLAMA_MODEL is the single source of truth for the chat model name, shared by
# both the app and the Ollama container via docker-compose.
# Tip: use a smaller model like llama3.2:3b for faster CPU-only responses.
OLLAMA_MODEL=qwen2.5:7b

# Embedding model used for RAG: turns text into 768-dim vectors.
# Must match the `dimensions` set for the pgvector store in application.yml.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# PostgreSQL (pgvector) connection settings, shared by the db container and app.
POSTGRES_DB=interview
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
