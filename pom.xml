<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.interviewAssistant.ai</groupId>
    <artifactId>AI-Interview-Assistant</artifactId>
    <version>1.0-SNAPSHOT</version>
    <description>An AI-powered interview preparation assistant using Spring AI, Ollama, RAG, PostgresSQL, and PGVector</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.ai.version>1.0.9</spring.ai.version>
    </properties>

    <!-- The BOM (Bill Of Materials) centrally pins versions for all Spring AI
         modules, so individual dependencies below can omit their <version>. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring.ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Core Spring Boot: gives us auto-configuration, logging, and the
             SpringApplication bootstrap. No web server yet - just enough to boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring AI + Ollama: auto-configures an OllamaChatModel and a
             ChatClient.Builder from the spring.ai.ollama.* properties in
             application.yml. This is what lets us call a local LLM. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!-- Reactive web stack: starts an embedded Netty server on port 8080.
             Provides Spring WebFlux (@RestController with reactive types) plus
             WebClient, which Spring AI uses for streaming (.stream()) responses. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- JDBC + HikariCP: guarantees a pooled DataSource is auto-configured
             for the pgvector store's JdbcTemplate to use. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- PGVector vector store: auto-configures a VectorStore backed by
             PostgreSQL + the pgvector extension. Brings in Spring JDBC and the
             schema auto-initialization used to store document embeddings. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- Vector-store advisors: provides QuestionAnswerAdvisor, which does the
             RAG plumbing (similarity search + prompt augmentation) for a ChatClient. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver used by the pgvector store's JdbcTemplate. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>